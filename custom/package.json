{
  "name": "decast-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run server.ts",
    "start:node": "tsx server.ts",
    "dev": "bun run server.ts",
    "dev:node": "tsx server.ts",
    "build": "bun run client/build.mjs",
    "seed": "bun run seed_shared_db.ts",
    "test": "bun test server/src client/src",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  }
}
